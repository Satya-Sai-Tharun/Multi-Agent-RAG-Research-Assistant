# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma:2b
EMBEDDING_MODEL=nomic-embed-text

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# Storage
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Cache
CACHE_MAX_SIZE=128
CACHE_TTL_SECONDS=3600

# App
DEBUG=false
